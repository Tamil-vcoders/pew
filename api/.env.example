FIREBASE_PROJECT_ID=pew-ideathon
CORS_ORIGINS=http://localhost:3000
# Local/CI only — never set these against the real project:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Phase 5 — Cloud Tasks (devspec §8). Set only in .github/workflows/deploy.yml for the
# deployed pew-api Cloud Run service; leaving these unset/blank keeps TASKS_MODE=inline,
# which is the correct local/CI default (Cloud Tasks itself can't run locally).
# TASKS_MODE=cloudtasks
# TASKS_QUEUE=cycle-iterations
# TASKS_LOCATION=asia-south1
# INTERNAL_INVOKER_SA=tasks-invoker@pew-ideathon.iam.gserviceaccount.com
# API_PUBLIC_URL=
